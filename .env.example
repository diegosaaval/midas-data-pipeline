# Copia a .env si quieres cambiar algo. Todo es opcional.
FINFLOW_SCALE=1.0              # volumen diario (1.0 ≈ 4.000 pagos/día)
FINFLOW_SEED=42
FINFLOW_EPOCH=2026-09-01       # primer día con datos
FINFLOW_SCHEMA_V2_FROM=2026-09-15  # desde aquí la fuente de pagos envía currency y channel
FINFLOW_LATE_DAYS=7            # ventana de datos tardíos aceptados en silver
FINFLOW_MAX_RETRIES=2
# Simular una falla transitoria para ver los reintentos, p. ej.: silver.payments:1
FINFLOW_FAIL=
