# Copia a .env si quieres cambiar algo. Todo es opcional.
MIDAS_SCALE=1.0              # volumen diario (1.0 ≈ 4.000 pagos/día)
MIDAS_SEED=42
MIDAS_EPOCH=2026-09-01       # primer día con datos
MIDAS_SCHEMA_V2_FROM=2026-09-15  # desde aquí la fuente de pagos envía currency y channel
MIDAS_LATE_DAYS=7            # ventana de datos tardíos aceptados en silver
MIDAS_MAX_RETRIES=2
# Simular una falla transitoria para ver los reintentos, p. ej.: silver.payments:1
MIDAS_FAIL=
